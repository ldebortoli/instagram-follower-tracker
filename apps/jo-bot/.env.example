# IDs numéricos separados por coma. Todos administran; el primero recibe avisos automáticos.
JO_BOT_ADMIN_USER_IDS=123456789,987654321
JO_BOT_TIMEZONE=America/Argentina/Buenos_Aires

# En Windows, Jo Bot reutiliza el token guardado por la interfaz en el almacén seguro.
# Sólo si no usás ese almacén, definí SEGUIDORES_TELEGRAM_BOT_TOKEN en tu entorno.
