[Unit]
Description=Jo Bot - seguimiento de Instagram por Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jo-bot
Group=jo-bot
WorkingDirectory=/var/lib/jo-bot
EnvironmentFile=/etc/jo-bot.env
ExecStart=/opt/jo-bot/venv/bin/jo-bot
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jo-bot

[Install]
WantedBy=multi-user.target
